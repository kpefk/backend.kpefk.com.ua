# ─────────────────────────────────────────────
# Тестовий тір (staging) — шаблон
#
# Скопіюй у .env.test і заповни. Файл .env.test у git НЕ потрапляє.
#
#   cp .env.test.example .env.test
#   docker compose --env-file .env.test --profile test up -d
#   bun run migrate:test
#   bun run start:test
#
# Значення тіра перекривають базовий .env: завантажується спершу .env.test,
# потім .env (див. src/config/environment.ts).
#
# Що тір `test` робить інакше за `development` і `production`:
#   • записи в ЄДЕБО — ЗАБЛОКОВАНІ на рівні EdboService, перемикача немає;
#   • Swagger — відкритий (/docs), як у dev;
#   • reCAPTCHA — вимкнена, щоб не блокувати ручні прогони;
#   • SMTP — з TLS, як у production;
#   • короткі SESSION_SECRET / COOKIES_SECRET — фатальна помилка, як у production.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=test
APPLICATION_PORT=4001                                   # Інший порт, ніж у dev (4000) — тіри піднімаються поруч
APPLICATION_URL=https://test-api.kpefk.com.ua           # Локально: http://localhost:4001
ALLOWED_ORIGIN=https://test.kpefk.com.ua                # Локально: http://localhost:3001

# ─────────────────────────────────────────────
# Cookies & Session
# ─────────────────────────────────────────────
# Секрети мають бути СВОЇ, не скопійовані з production: staging доступний ширшому
# колу людей, і витік звідти не повинен відкривати бойові сесії.
#
# Генеруй БЕЗ символу «$»:  openssl rand -hex 32
# Цей файл читає і docker compose (--env-file), а він інтерполює «$» у значеннях:
# base64-секрет із «$» дає попередження «variable is not set» і може зіпсувати
# пароль БД. Якщо «$» усе ж потрібен — подвоюй його: «$$».
COOKIES_SECRET=                             # ≥32 символів, інакше застосунок не стартує
SESSION_SECRET=                             # ≥32 символів, інакше застосунок не стартує
SESSION_NAME=session
SESSION_DOMAIN=test.kpefk.com.ua            # Локально: localhost
SESSION_MAX_AGE=7d                          # Коротше за production — staging-сесії не мають жити місяць
SESSION_HTTP_ONLY=true
SESSION_SECURE=true                         # false, якщо піднімаєш локально по http
SESSION_FOLDER=kpefk-test:                  # ОБОВ'ЯЗКОВО інший префікс, ніж у dev/prod — інакше сесії тірів змішаються в Redis

# ─────────────────────────────────────────────
# PostgreSQL — окрема БД тіра (compose-профіль test, порт 5434)
# ─────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5434                          # 5433 — це dev; не переплутай
POSTGRES_DB=my_kpefk_test
POSTGRES_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_POOL_MAX=5                         # Staging тримає менше навантаження, ніж production

# ─────────────────────────────────────────────
# Redis — окремий інстанс тіра (порт 6380)
# ─────────────────────────────────────────────
REDIS_USER=admin
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6380                             # 6379 — це dev

# ─────────────────────────────────────────────
# Mail (SMTP)
# ─────────────────────────────────────────────
# MAIL_* має вказувати на ТЕСТОВУ скриньку або catch-all. Тір проганяє реальні
# сценарії (відновлення паролю, 2FA, видача корпоративних акаунтів), і при
# бойових SMTP-даних листи полетять справжнім здобувачам.
MAIL_HOST=
MAIL_PORT=587
MAIL_LOGIN=
MAIL_PASSWORD=

# ─────────────────────────────────────────────
# Google reCAPTCHA
# ─────────────────────────────────────────────
# У тірі test перевірка вимкнена політикою, але змінна обов'язкова за схемою
# валідації — лишай тестовий ключ Google.
GOOGLE_RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# ─────────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────────
# Потрібен ОКРЕМИЙ OAuth-клієнт із redirect URI тіра, інакше вхід через Google
# віддаватиме користувача на production-домен.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────
# Google Drive (Service Account)
# ─────────────────────────────────────────────
# Окрема тека Drive для тіра — інакше тестові завантаження засмітять бойову.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=

# ─────────────────────────────────────────────
# EDBO Integration
# ─────────────────────────────────────────────
# Читання з ЄДЕБО працює і в тірі test — саме тому тут бойові облікові дані.
# Записи заблоковані в коді (EdboService.post → HTTP 403), змінної-перемикача
# не існує. Якщо потрібен прогін без жодного звернення до реєстру — лиши
# EDBO_BASE_URL на локальний заглушковий сервер.
EDEBO_CODE=563
EDBO_BASE_URL=http://localhost:8080/data/EDEBOWebApi
EDBO_APP_KEY=
EDBO_USER_LOGIN=
EDBO_USER_PASSWORD=
